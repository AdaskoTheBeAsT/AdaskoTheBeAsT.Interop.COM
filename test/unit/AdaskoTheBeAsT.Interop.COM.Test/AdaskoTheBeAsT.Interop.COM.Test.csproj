<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0;net481;net48;net472;net471;net47;net462</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Explicit process architecture wins; preserve the historical defaults otherwise. -->
  <PropertyGroup>
    <NativeTestArchitecture Condition="'$(PlatformTarget)' == 'x86' OR '$(PlatformTarget)' == 'x64'">$(PlatformTarget)</NativeTestArchitecture>
    <NativeTestArchitecture Condition="'$(NativeTestArchitecture)' == '' AND '$(RuntimeIdentifier)' == 'win-x86'">x86</NativeTestArchitecture>
    <NativeTestArchitecture Condition="'$(NativeTestArchitecture)' == '' AND '$(RuntimeIdentifier)' == 'win-x64'">x64</NativeTestArchitecture>
    <NativeTestArchitecture Condition="'$(NativeTestArchitecture)' == '' AND ('$(Platform)' == 'x86' OR '$(Platform)' == 'x64')">$(Platform)</NativeTestArchitecture>
    <NativeTestArchitecture Condition="'$(NativeTestArchitecture)' == '' AND $(TargetFramework.StartsWith('net4'))">x86</NativeTestArchitecture>
    <NativeTestArchitecture Condition="'$(NativeTestArchitecture)' == ''">x64</NativeTestArchitecture>
    <PlatformTarget Condition="'$(PlatformTarget)' == '' OR '$(PlatformTarget)' == 'AnyCPU'">$(NativeTestArchitecture)</PlatformTarget>
    <OutputPath>bin\$(NativeTestArchitecture)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(NativeTestArchitecture)\$(Configuration)\</IntermediateOutputPath>
    <NativeProbeOutput>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\$(NativeTestArchitecture)\native\</NativeProbeOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\AdaskoTheBeAsT.Interop.COM\AdaskoTheBeAsT.Interop.COM.csproj"
                      GlobalPropertiesToRemove="Platform;PlatformTarget;NativeTestArchitecture;RuntimeIdentifier" />
  </ItemGroup>

  <!--
    Interop.NativeCOM.dll is MSIL-neutral (tlbimp /machine:Agnostic).
    One copy loads in both 32-bit and 64-bit processes.
  -->
  <ItemGroup>
    <Reference Include="Interop.NativeCOM">
      <HintPath>..\..\..\x86\Debug\Interop.NativeCOM.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Copy even when switching architectures in an existing output directory. -->
  <ItemGroup Condition="'$(NativeTestArchitecture)' == 'x86'">
    <None Include="..\..\..\x86\Debug\NativeCOM.dll">
      <Link>NativeCOM.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>NativeCOM.dll</TargetPath>
    </None>
    <None Include="..\..\..\manifest\NativeCOM\NativeCOM.manifest">
      <Link>NativeCOM.manifest</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>NativeCOM.manifest</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(NativeTestArchitecture)' == 'x64'">
    <None Include="..\..\..\x64\Debug\NativeCOM.dll">
      <Link>NativeCOM.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>NativeCOM.dll</TargetPath>
    </None>
    <None Include="..\..\..\manifest\NativeCOM\NativeCOM.x64.manifest">
      <Link>NativeCOM.manifest</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>NativeCOM.manifest</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NativeProbeOutput)NativeLifetimeProbe.dll" Link="NativeLifetimeProbe.dll" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <Target Name="BuildNativeLifetimeProbe" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(PlatformTarget)' != 'x86' AND '$(PlatformTarget)' != 'x64'"
           Text="Native COM tests support only x86 and x64 test processes." />
    <Error Condition="'$(RuntimeIdentifier)' != '' AND '$(RuntimeIdentifier)' != 'win-x86' AND '$(RuntimeIdentifier)' != 'win-x64'"
           Text="Native COM tests support only win-x86 and win-x64 runtime identifiers." />
    <Exec Command="powershell.exe -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\..\native\Build-NativeLifetimeProbe.ps1&quot; -Architecture $(NativeTestArchitecture) -OutputDirectory &quot;$(NativeProbeOutput).&quot;" />
  </Target>

</Project>
